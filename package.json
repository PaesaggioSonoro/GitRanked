{
  "name": "gitranked",
  "version": "1.0.0",
  "description": "An auditable index of publicly verifiable GitHub development activity",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "gitranked": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "dev": "tsx src/cli/index.ts",
    "prepack": "npm run build",
    "fixture": "tsx scripts/fixture.ts && prettier --write tests/fixtures/report.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PaesaggioSonoro/GitRanked.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
